  <!-- =========================================================================
       CAMPUS LOCATIONS & LIVE WAIT TIMES
       ========================================================================= -->
  <section class="section-wrapper" id="locations" style="background:#ffffff; border-top:1px solid #e2e8f0;">
    <div class="section-head-center">
      <span class="section-tag">Campus & Emergency Readiness</span>
      <h2 class="section-title">Live Facility Status & Wait Times</h2>
      <p class="section-desc">
        Real-time telemetry of triage queues across our hospital network to ensure zero delay in acute care.
      </p>
    </div>

    <div class="locations-grid">
      <div class="location-card">
        <div class="loc-head">
          <div>
            <h3>Main Hospital & Level 1 Trauma</h3>
            <p style="font-size:0.85rem; color:#64748b;">500 Aegis Boulevard, Metro City</p>
          </div>
          <span class="loc-badge level1">Level 1 ER</span>
        </div>
        <div class="loc-wait-display">
          <div>
            <div style="font-size:0.75rem; color:#64748b; font-weight:700;">CURRENT ER WAIT</div>
            <div class="loc-wait-val" id="loc-wait-main">12 mins</div>
          </div>
          <span class="pulse-dot"></span>
        </div>
        <p style="font-size:0.85rem; color:#475569; margin-bottom:16px;">Open 24/7/365. Full surgical teams and cath-labs on standby.</p>
        <button class="btn btn-secondary btn-sm" style="width:100%;" onclick="openDirections('500 Aegis Boulevard')">Get GPS Navigation</button>
      </div>

      <div class="location-card">
        <div class="loc-head">
          <div>
            <h3>West Valley Urgent Care & Outpatient</h3>
            <p style="font-size:0.85rem; color:#64748b;">1420 West Valley Parkway</p>
          </div>
          <span class="loc-badge" style="background:#fef3c7; color:#d97706;">Urgent Care</span>
        </div>
        <div class="loc-wait-display">
          <div>
            <div style="font-size:0.75rem; color:#64748b; font-weight:700;">URGENT CARE WAIT</div>
            <div class="loc-wait-val" id="loc-wait-west">4 mins</div>
          </div>
          <span class="pulse-dot" style="background:#10b981;"></span>
        </div>
        <p style="font-size:0.85rem; color:#475569; margin-bottom:16px;">Open Daily 7 AM - 11 PM. On-site digital X-ray and stat labs.</p>
        <button class="btn btn-secondary btn-sm" style="width:100%;" onclick="openDirections('1420 West Valley Parkway')">Get GPS Navigation</button>
      </div>

      <div class="location-card">
        <div class="loc-head">
          <div>
            <h3>North Shore Children's & Family Center</h3>
            <p style="font-size:0.85rem; color:#64748b;">880 Harbor Ridge Road</p>
          </div>
          <span class="loc-badge" style="background:#e0f2fe; color:#0284c7;">Pediatric Pavilion</span>
        </div>
        <div class="loc-wait-display">
          <div>
            <div style="font-size:0.75rem; color:#64748b; font-weight:700;">PEDIATRIC TRIAGE</div>
            <div class="loc-wait-val" id="loc-wait-north">8 mins</div>
          </div>
          <span class="pulse-dot" style="background:#0284c7;"></span>
        </div>
        <p style="font-size:0.85rem; color:#475569; margin-bottom:16px;">Open 24/7. Specialized child-life specialists and pediatric emergency suites.</p>
        <button class="btn btn-secondary btn-sm" style="width:100%;" onclick="openDirections('880 Harbor Ridge Road')">Get GPS Navigation</button>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       APPOINTMENT BOOKING MODAL
       ========================================================================= -->
  <div class="modal-overlay" id="appointment-modal">
    <div class="modal-container">
      <div class="modal-header">
        <h3>Schedule Clinic Consultation</h3>
        <button class="modal-close-btn" id="modal-close-booking">&times;</button>
      </div>
      <div class="modal-body">
        <form id="booking-form">
          <div class="pane-block">
            <h4 style="font-size:0.95rem; margin-bottom:12px;">1. Specialty & Physician</h4>
            <div class="patient-profile-row">
              <div class="form-group">
                <label>Department</label>
                <select id="modal-select-dept" class="select-control">
                  <option value="Cardiology & Heart Institute">Cardiology & Heart Institute</option>
                  <option value="Pulmonology & Respiratory Medicine">Pulmonology & Respiratory Medicine</option>
                  <option value="Neurology & Headache Center">Neurology & Headache Center</option>
                  <option value="General Surgery & Acute Care">General Surgery & Acute Care</option>
                  <option value="Gastroenterology & Digestive Health">Gastroenterology & Digestive Health</option>
                  <option value="Orthopedics & Sports Medicine">Orthopedics & Sports Medicine</option>
                </select>
              </div>
              <div class="form-group">
                <label>Physician</label>
                <select id="modal-select-doc" class="select-control">
                  <!-- Populated dynamically -->
                </select>
              </div>
            </div>
          </div>

          <div class="pane-block">
            <h4 style="font-size:0.95rem; margin-bottom:12px;">2. Date & Time Slot</h4>
            <div class="patient-profile-row">
              <div class="form-group">
                <label>Preferred Date</label>
                <input type="date" id="booking-date" class="input-control" required>
              </div>
              <div class="form-group">
                <label>Available Time Slot</label>
                <select id="booking-time" class="select-control">
                  <option>09:30 AM (Morning)</option>
                  <option>11:15 AM (Morning)</option>
                  <option selected>02:30 PM (Afternoon)</option>
                  <option>04:00 PM (Late Afternoon)</option>
                </select>
              </div>
            </div>
          </div>

          <div class="pane-block">
            <h4 style="font-size:0.95rem; margin-bottom:12px;">3. Patient Information</h4>
            <div class="patient-profile-row">
              <div class="form-group">
                <label>Full Legal Name</label>
                <input type="text" id="patient-name" class="input-control" placeholder="e.g. Eleanor Davis" required>
              </div>
              <div class="form-group">
                <label>Contact Phone</label>
                <input type="tel" id="patient-phone" class="input-control" placeholder="(555) 012-3456" required>
              </div>
            </div>
            <div class="form-group">
              <label>Reason for Visit / Symptoms (Auto-synced with Diagnostic tool)</label>
              <textarea id="patient-symptom-note" class="input-control" rows="2" placeholder="Describe symptoms or reasons..."></textarea>
            </div>
          </div>

          <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:20px;">
            <button type="button" class="btn btn-secondary btn-sm" id="btn-cancel-booking">Cancel</button>
            <button type="submit" class="btn btn-primary btn-sm">Confirm & Reserve Slot</button>
          </div>
        </form>

        <div id="booking-success-box" style="display:none; text-align:center; padding:20px;">
          <div style="width:60px; height:60px; background:#dcfce7; color:#16a34a; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; margin-bottom:16px;">
            <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </div>
          <h3 style="color:#166534; margin-bottom:8px;">Appointment Confirmed!</h3>
          <p id="booking-confirmation-details" style="font-size:0.92rem; color:#334155; margin-bottom:20px; line-height:1.5;">
            Your visit has been reserved. A confirmation SMS with directions and clinical intake forms has been sent.
          </p>
          <button class="btn btn-secondary btn-sm" id="btn-close-success">Done</button>
        </div>
      </div>
    </div>
  </div>

