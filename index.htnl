          <h3 style="font-size: 1.15rem; font-weight: 700;">Aegis Triage Diagnostic Studio</h3>
          <span class="studio-badge-ai">Live Clinical Engine</span>
        </div>
        <div class="studio-tabs">
          <button class="studio-tab-btn active" data-tab="interactive" id="tab-interactive">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            Interactive Diagnoser
          </button>
          <button class="studio-tab-btn" data-tab="emergency-protocols" id="tab-emergency-guidelines">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            Emergency Red Flags
          </button>
        </div>
      </div>

      <!-- Studio 2-Column Split: Inputs (Left) & Real-Time Differential Output (Right) -->
      <div class="studio-layout-grid">
        
        <!-- Left: Patient Parameters & Symptom Selection -->
        <div class="studio-input-pane">
          
          <!-- Step 1: Patient Context & Medical History -->
          <div class="pane-block">
            <h4 class="block-title">
              <span class="step-num">1</span> Patient Profile & Risk Factors
            </h4>
            <div class="patient-profile-row">
              <div class="form-group">
                <label for="select-age">Age Bracket</label>
                <select id="select-age" class="select-control">
                  <option value="child">Child / Adolescent (&lt; 18)</option>
                  <option value="adult" selected>Adult (18 - 64 years)</option>
                  <option value="senior">Senior Citizen (65+ years)</option>
                </select>
              </div>
              <div class="form-group">
                <label for="select-sex">Biological Sex</label>
                <select id="select-sex" class="select-control">
                  <option value="female">Female</option>
                  <option value="male">Male</option>
                  <option value="other">Prefer not to say</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label>Known Pre-existing Medical Conditions:</label>
              <div class="comorbidity-chips">
                <label class="checkbox-pill">
                  <input type="checkbox" name="comorbidity" value="hypertension">
                  <span class="pill-content">Hypertension</span>
                </label>
                <label class="checkbox-pill">
                  <input type="checkbox" name="comorbidity" value="diabetes">
                  <span class="pill-content">Diabetes</span>
                </label>
                <label class="checkbox-pill">
                  <input type="checkbox" name="comorbidity" value="asthma_copd">
                  <span class="pill-content">Asthma / COPD</span>
                </label>
                <label class="checkbox-pill">
                  <input type="checkbox" name="comorbidity" value="heart_disease">
                  <span class="pill-content">Heart Disease</span>
                </label>
                <label class="checkbox-pill">
                  <input type="checkbox" name="comorbidity" value="smoker">
                  <span class="pill-content">Tobacco Smoker</span>
                </label>
                <label class="checkbox-pill">
                  <input type="checkbox" name="comorbidity" value="pregnancy">
                  <span class="pill-content">Pregnancy</span>
                </label>
              </div>
            </div>
          </div>

          <!-- Step 2: Anatomical Body Region -->
          <div class="pane-block">
            <h4 class="block-title">
              <span class="step-num">2</span> Select Primary Body Region
            </h4>
            <div class="body-region-grid" id="region-selector-grid">
              <!-- Dynamically populated or static body zones -->
              <button class="region-btn active" data-region="chest">
                <div class="region-icon">
                  <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"></path></svg>
                </div>
                <span class="region-title">Chest & Heart</span>
              </button>

              <button class="region-btn" data-region="head_neck">
                <div class="region-icon">
                  <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="7"></circle><path d="M12 9v4l2 2"></path></svg>
                </div>
                <span class="region-title">Head & Neck</span>
              </button>

              <button class="region-btn" data-region="abdomen">
                <div class="region-icon">
                  <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2"></rect><circle cx="12" cy="12" r="3"></circle></svg>
                </div>
                <span class="region-title">Abdomen & Gut</span>
              </button>

              <button class="region-btn" data-region="pelvic">
                <div class="region-icon">
                  <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                </div>
                <span class="region-title">Pelvic & Flank</span>
              </button>

              <button class="region-btn" data-region="limbs">
                <div class="region-icon">
                  <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="6" cy="6" r="3"></circle><circle cx="18" cy="18" r="3"></circle><line x1="8.5" y1="8.5" x2="15.5" y2="15.5"></line></svg>
                </div>
                <span class="region-title">Limbs & Joints</span>
              </button>

              <button class="region-btn" data-region="general">
                <div class="region-icon">
                  <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 14.76V3.5a2.5 2.5 0 00-5 0v11.26a4.5 4.5 0 105 0z"></path></svg>
                </div>
                <span class="region-title">Systemic / Skin</span>
              </button>
            </div>

            <!-- Symptom Filter Chips for Selected Region -->
            <div class="symptom-picker-container">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                <label style="font-size:0.82rem; font-weight:700; color:#334155;">Reported Symptoms in Selected Region:</label>
                <span style="font-size:0.75rem; color:#dc2626; font-weight:600;">Red marker = Critical Alert</span>
              </div>
              <div class="symptom-list-chips" id="region-symptoms-list">
                <!-- Injected via diagnostics.js -->
              </div>
            </div>
          </div>

          <!-- Step 3: Severity, Duration & Active Symptoms Tray -->
          <div class="pane-block">
            <h4 class="block-title">
              <span class="step-num">3</span> Pain Severity & Duration
            </h4>
            <div class="slider-group">
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <label for="severity-slider" style="font-size:0.85rem; font-weight:600;">Discomfort / Severity Scale:</label>
                <strong id="severity-display" style="font-size:1rem; color:var(--primary-blue);">5 / 10 (Moderate)</strong>
              </div>
              <input type="range" id="severity-slider" class="severity-slider" min="1" max="10" value="5">
              <div class="slider-labels">
                <span>1 Mild</span>
                <span>4 Moderate</span>
                <span>7 Severe</span>
                <span>10 Emergency</span>
              </div>
            </div>

            <div class="form-group" style="margin-top:16px;">
              <label for="select-duration">How long have these symptoms persisted?</label>
              <select id="select-duration" class="select-control">
                <option value="hours">Just started (Past few hours)</option>
                <option value="days" selected>1 to 3 Days</option>
                <option value="weeks">1 to 2 Weeks</option>
                <option value="chronic">Over a month (Chronic)</option>
              </select>
            </div>

            <!-- Active Selected Symptoms Tray -->
            <div class="selected-tray" id="active-symptoms-tray">
              <span class="tray-label">Active Symptoms:</span>
              <div id="tray-chips-container" style="display:contents;">
                <!-- Injected chips -->
                <span style="font-size:0.82rem; color:#94a3b8; font-style:italic;">No symptoms selected yet. Pick from above or search.</span>
              </div>
            </div>
          </div>

        </div>

        <!-- Right: Real-time Live Diagnostic Assessment & Recommendations -->
        <div class="studio-output-pane" id="studio-output-pane">
          
          <!-- Emergency Red-Flag Warning Box (Dynamically shown) -->
          <div class="emergency-alarm-card" id="emergency-alert-box" style="display: none;">
            <div class="alarm-header">
              <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
              <h3 id="emergency-alert-title">CRITICAL RED-FLAG ALERT</h3>
            </div>
            <p class="alarm-text" id="emergency-alert-desc">
              Your symptoms match an acute high-risk medical scenario requiring immediate clinical intervention. Do not wait for a scheduled office visit.
            </p>
            <div class="alarm-actions">
              <a href="tel:911" class="btn btn-secondary btn-sm" style="color:#b91c1c; font-weight:800;">
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"></path></svg>
                Call 911 Immediately
              </a>
              <button class="btn btn-secondary btn-sm" id="btn-er-route" style="color:#1e293b;">
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2a8 8 0 00-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 00-8-8z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                Direct GPS to Aegis ER
              </button>
            </div>
          </div>

          <!-- Triage Tier Determination Card -->
          <div class="triage-tier-card" id="triage-tier-card">
            <div class="triage-badge-strip">
              <span class="triage-status-badge badge-routine" id="triage-status-badge">Routine Consultation (Level 4)</span>
              <span class="triage-wait-pill" id="triage-wait-estimate">Next opening: Today</span>
            </div>
            <h3 id="triage-recommendation-title">Initial Triage Impression</h3>
            <p id="triage-recommendation-text">
              Please select symptoms from the left panel to begin diagnostic analysis and view differential assessments.
            </p>
          </div>

          <!-- Differential Diagnoses / Matched Probabilities -->
          <div class="differential-box">
            <h4>
              <span>Differential Clinical Matches</span>
              <small style="font-size:0.75rem; color:#64748b; font-weight:500;">Based on clinical algorithms</small>
            </h4>
            <div id="differential-matches-list">
              <p style="font-size:0.85rem; color:#94a3b8; font-style:italic;">
                No symptoms added. Choose symptoms above to compute likelihood percentages.
              </p>
            </div>
          </div>

          <!-- Recommended Specialist / Doctor at Hospital -->
          <div class="specialist-recom-card" id="specialist-recom-card">
            <div class="recom-head">Recommended Aegis Specialist</div>
            <div class="doctor-mini-row" id="doctor-mini-content">
              <div class="doc-info-cluster">
                <div class="doc-mini-avatar" id="recom-doc-avatar">ER</div>
                <div>
                  <div class="doc-name" id="recom-doc-name">Dr. Evelyn Reed, MD</div>
                  <div class="doc-sub" id="recom-doc-specialty">Cardiology & Heart Institute</div>
                </div>
              </div>
              <button class="btn btn-primary btn-sm" id="btn-recom-book">Book Consult</button>
            </div>
          </div>

          <!-- Diagnostic Action Tools -->
          <div class="studio-action-row">
            <button class="btn btn-secondary btn-sm" id="btn-print-report" style="width:100%;">
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"></path><path d="M6 14h12v8H6z"></path></svg>
              Print / Save Clinical Report for Physician
            </button>
            <button class="btn btn-teal btn-sm" id="btn-reset-diagnostics">
              Reset
            </button>
          </div>

          <!-- Strict Medical Disclaimer -->
          <div class="clinical-disclaimer">
            <strong>Medical Notice:</strong> This interactive home page diagnostic assessment is an AI-assisted clinical decision-support and triage tool for informational triage purposes. It does not establish a formal physician-patient relationship or constitute a definitive medical diagnosis. If experiencing acute emergency symptoms, call 911 immediately.
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- =========================================================================
       HOSPITAL SPECIALTIES & CENTERS OF EXCELLENCE
       ========================================================================= -->
  <section class="section-wrapper" id="specialties" style="background:#ffffff; border-top:1px solid #e2e8f0; border-bottom:1px solid #e2e8f0;">
    <div class="section-head-center">
      <span class="section-tag">Centers of Excellence</span>
      <h2 class="section-title">Specialized Clinical Departments</h2>
      <p class="section-desc">
        Integrated multidisciplinary medicine combining research, advanced robotic surgery, and personalized therapeutics.
      </p>
    </div>

    <div class="dept-grid">
      <div class="dept-card">
        <div class="dept-icon">
          <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"></path></svg>
        </div>
        <h3>Cardiovascular & Heart Institute</h3>
        <p>Comprehensive transcatheter valves, electrophysiology, coronary stenting, and congestive heart failure programs.</p>
        <div class="dept-stats">
          <span>Door-to-Balloon: <strong>48 mins</strong></span>
          <span>Surgeons: <strong>24 Boarded</strong></span>
        </div>
      </div>

      <div class="dept-card">
        <div class="dept-icon">
          <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="7"></circle><path d="M12 9v4l2 2"></path></svg>
        </div>
        <h3>Neuroscience & Comprehensive Stroke</h3>
        <p>State-certified Level 1 Stroke Center featuring biplane neuro-angiography, epilepsy monitoring, and minimally invasive spine surgery.</p>
        <div class="dept-stats">
          <span>Stroke Triage: <strong>14 mins</strong></span>
          <span>Neuro-ICU: <strong>32 Beds</strong></span>
        </div>
      </div>

      <div class="dept-card">
        <div class="dept-icon">
          <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 14.76V3.5a2.5 2.5 0 00-5 0v11.26a4.5 4.5 0 105 0z"></path></svg>
        </div>
        <h3>Pulmonary & Critical Care Medicine</h3>
        <p>Advanced bronchial thermoplasty, asthma biologics, interventional bronchoscopy, and specialized post-viral pulmonary recovery.</p>
        <div class="dept-stats">
          <span>Critical Care Units: <strong>4</strong></span>
          <span>Same-Day Clinic: <strong>Yes</strong></span>
        </div>
      </div>

      <div class="dept-card">
        <div class="dept-icon">
          <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="6" cy="6" r="3"></circle><circle cx="18" cy="18" r="3"></circle><line x1="8.5" y1="8.5" x2="15.5" y2="15.5"></line></svg>
        </div>
        <h3>Orthopedics & Joint Reconstruction</h3>
        <p>Robotic Mako-assisted knee and hip replacements, sports medicine, arthroscopy, and complex trauma bone repair.</p>
        <div class="dept-stats">
          <span>Robotic Precision: <strong>99.8%</strong></span>
          <span>Outpatient Rehab: <strong>On-Site</strong></span>
        </div>
      </div>

      <div class="dept-card">
        <div class="dept-icon">
          <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2"></rect><circle cx="12" cy="12" r="3"></circle></svg>
        </div>
        <h3>Gastroenterology & Digestive Health</h3>
        <p>High-definition endoscopic ultrasound, IBD biologic infusion center, advanced hepatology, and acid reflux motility clinic.</p>
        <div class="dept-stats">
          <span>Endoscopy Suites: <strong>8</strong></span>
          <span>Capsule Scope: <strong>Available</strong></span>
        </div>
      </div>

      <div class="dept-card">
        <div class="dept-icon" style="background:#fee2e2; color:#dc2626;">
          <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"></path></svg>
        </div>
        <h3>24/7 Level-1 Emergency & Trauma</h3>
        <p>Helipad-equipped adult and pediatric emergency resuscitation pavilions with immediate on-site cardiothoracic and neurosurgical backup.</p>
        <div class="dept-stats">
          <span>Trauma Bays: <strong>16</strong></span>
          <span>Average Door-to-MD: <strong>12 mins</strong></span>
        </div>
      </div>
    </div>
  </section>

